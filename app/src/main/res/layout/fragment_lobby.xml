<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0A0F"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/lobbyTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="LOBBY"
            android:textColor="#E8E8F0"
            android:textSize="28sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            tools:ignore="HardcodedText" />

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            app:cardBackgroundColor="#12121A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lobbyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#E8E8F0"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="Lobby Name" />

                <TextView
                    android:id="@+id/lobbyRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#9898A8"
                    android:textSize="14sp"
                    tools:text="Role" />

                <TextView
                    android:id="@+id/lobbyId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#606070"
                    android:textSize="12sp"
                    android:fontFamily="monospace"
                    tools:text="abc123" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/lobbyNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#FF2B2B"
            android:textSize="14sp"
            android:visibility="gone"
            tools:text="Notification"
            tools:visibility="visible" />

    </LinearLayout>
</ScrollView>
