<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="#12121A"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/pendingDevice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#E8E8F0"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Device Name" />

        <TextView
            android:id="@+id/pendingIp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="#606070"
            android:textSize="12sp"
            android:fontFamily="monospace"
            tools:text="192.168.1.1" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnShowCode"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Код"
                android:textAllCaps="false"
                android:textColor="#E8E8F0"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="#2A2A38"
                app:strokeWidth="1dp"
                app:insetTop="0dp"
                app:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnConfirm"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="Подтвердить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#6C5CE7"
                app:cornerRadius="12dp"
                app:insetTop="0dp"
                app:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReject"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Отклонить"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                app:backgroundTint="#FF2B2B"
                app:cornerRadius="12dp"
                app:insetTop="0dp"
                app:insetBottom="0dp" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
