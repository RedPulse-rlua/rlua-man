<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0A0505"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="60dp"
            android:fontFamily="monospace"
            android:text="rl"
            android:textColor="#F4E8E8"
            android:textSize="42sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="rlua"
            android:textColor="#A37C7C"
            android:textSize="14sp" />

        <!-- Auth form -->
        <LinearLayout
            android:id="@+id/authSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:orientation="vertical">

            <EditText
                android:id="@+id/inputUsername"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#1A0B0B"
                android:hint="Ник"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#F4E8E8"
                android:textColorHint="#5A3A3A"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inputWord"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#1A0B0B"
                android:hint="Секретное слово"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#F4E8E8"
                android:textColorHint="#5A3A3A"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/inputPassword"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#1A0B0B"
                android:hint="Пароль"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:paddingHorizontal="16dp"
                android:textColor="#F4E8E8"
                android:textColorHint="#5A3A3A"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#FF5C7A"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/successText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="#4ADE80"
                android:textSize="13sp"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginTop="12dp"
                android:indeterminateTint="#FF2D2D"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:background="#FF2D2D"
                android:gravity="center"
                android:text="Войти"
                android:textColor="#F4E8E8"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/btnRegister"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:background="#1A0B0B"
                android:gravity="center"
                android:text="Создать аккаунт"
                android:textColor="#A37C7C"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:text="rlua"
                android:textColor="#5A3A3A"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 2FA waiting screen -->
        <LinearLayout
            android:id="@+id/verifySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="48dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ПОДТВЕРЖДЕНИЕ"
                android:textColor="#F4E8E8"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/verifyDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Подтвердите вход на основном устройстве"
                android:textAlignment="center"
                android:textColor="#A37C7C"
                android:textSize="14sp" />

            <ProgressBar
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginTop="24dp"
                android:indeterminateTint="#FF2D2D" />

            <TextView
                android:id="@+id/verifyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Ожидание подтверждения..."
                android:textAlignment="center"
                android:textColor="#5A3A3A"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/inputCode"
                android:layout_width="200dp"
                android:layout_height="52dp"
                android:layout_marginTop="24dp"
                android:background="#1A0B0B"
                android:gravity="center"
                android:hint="Код из приложения"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="6"
                android:textColor="#F4E8E8"
                android:textColorHint="#5A3A3A"
                android:textSize="24sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnSubmitCode"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#FF2D2D"
                android:gravity="center"
                android:text="Подтвердить"
                android:textColor="#F4E8E8"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/btnVerifyCancel"
                android:layout_width="200dp"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="#1A0B0B"
                android:gravity="center"
                android:text="Отмена"
                android:textColor="#A37C7C"
                android:textSize="14sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
